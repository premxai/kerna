{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kerna.dev/contracts/security-action-inventory.schema.json",
  "title": "Kerna security action inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviewed_commit", "statuses", "sensitive_patterns", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "reviewed_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "statuses": {
      "type": "array",
      "const": ["governed", "contained", "trusted-host-only", "intentionally-excluded", "open-bypass"]
    },
    "sensitive_patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "entrypoint", "initiator", "controlled_inputs", "operation", "privileges", "enforcement_point", "containment_boundary", "receipt_coverage", "failure_behavior", "platforms", "tests", "source_files", "status", "risk"],
      "properties": {
        "id": { "type": "string", "pattern": "^SB-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "initiator": { "enum": ["model", "agent", "untrusted-repository", "plugin", "operator", "kerna"] },
        "controlled_inputs": { "type": "array", "items": { "type": "string" } },
        "operation": { "type": "array", "items": { "enum": ["filesystem", "process", "network", "credential", "container", "external-service", "evidence"] } },
        "privileges": { "type": "string", "minLength": 1 },
        "enforcement_point": { "type": "string", "minLength": 1 },
        "containment_boundary": { "type": "string", "minLength": 1 },
        "receipt_coverage": { "type": "string", "minLength": 1 },
        "failure_behavior": { "type": "string", "minLength": 1 },
        "platforms": { "type": "array", "items": { "enum": ["windows", "macos", "linux"] } },
        "tests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["governed", "contained", "trusted-host-only", "intentionally-excluded", "open-bypass"] },
        "risk": { "enum": ["P0", "P1", "P2", "accepted"] },
        "remediation_task": { "type": ["integer", "null"], "minimum": 2, "maximum": 8 },
        "evidence": { "type": "string" }
      }
    }
  }
}
