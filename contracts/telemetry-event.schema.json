{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kerna.dev/schemas/gauntlet-telemetry-event.schema.json",
  "title": "Kerna Gauntlet Telemetry Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "execution_mode",
    "policy_mode",
    "agent",
    "wave",
    "case_id",
    "call_hash",
    "tool",
    "decision",
    "result_class",
    "useful",
    "latency_ms",
    "started_at",
    "finished_at",
    "task_db_id",
    "kerna_trace_id",
    "message"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "execution_mode": { "enum": ["parallel", "sequential"] },
    "policy_mode": { "enum": ["weak", "strong"] },
    "agent": { "enum": ["utility", "mutation", "containment"] },
    "wave": { "type": "integer", "minimum": 0 },
    "case_id": { "type": "string", "minLength": 1 },
    "call_hash": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["allow", "deny", "approval_required", "error"] },
    "result_class": { "enum": ["useful", "harmful", "blocked", "error"] },
    "useful": { "type": "boolean" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "task_db_id": { "type": "string", "minLength": 1 },
    "kerna_trace_id": { "type": "string" },
    "message": { "type": "string" }
  }
}
