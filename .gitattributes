# Shell scripts must keep LF endings or they break when run (CRLF corrupts the shebang).
*.sh text eol=lf
install.sh text eol=lf
scripts/*.sh text eol=lf
# Files executed or fingerprinted inside Linux containers must remain byte-stable.
examples/filesystem-mcp/plugin/*.py text eol=lf
examples/filesystem-mcp/manifest.toml text eol=lf
# PowerShell is fine with either, but keep it consistent.
*.ps1 text eol=crlf
